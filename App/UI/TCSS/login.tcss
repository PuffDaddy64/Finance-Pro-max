
 
$borderColor: #6B6A2E;
$ErrorColor: #D94F83;
$textcolor: #D2D5CC;


 Screen{
     align: center middle;
     background: #101210;
           
}



 Input{
    background:white 0%;
    border: dashed $borderColor  20%;
    tint: #267326 5%;
    border-subtitle-color: $borderColor 75%;
    border-title-color: $borderColor 75%;

            
    }
    Input:focus{
        border: dashed $borderColor 50%;
    }

    Input.invalid:focus{
        border-title-color:  $ErrorColor 75%;
        background: $ErrorColor 5%;	
        border: dashed $ErrorColor 50%;


    }
    Input.invalid{
        border: dashed $ErrorColor 20%;
        border-title-color:  $ErrorColor 50%;
    }



#login{
	Label{
		border: ascii $borderColor  62%;
		padding:1;

		align: center middle;

		color: #D9AD54 80%;		
	}

		
	#messageBox{
		
		border: double $borderColor 55%;
		box-sizing: border-box;
		max-height: 45%;
		margin-bottom:0;
	
		Container{
			align: center top;
			margin:2;
			padding:1;
			height: auto;

			
		}
		

		Label{
			align: center bottom;
		}
		#errorMessage {
			align: right top;
			margin: 0 ;	
			padding: 0;
			Label{
				border: dashed $borderColor  20%;
				align: right top;
				padding:2 0;
				margin:0;}
		}
		#buttonBox{
			box-sizing: border-box;
			margin: 0;
		 Button{
			max-height: 50%;
			
		 }
		 #yes{
				border: dashed $borderColor  20%;
				background: $borderColor  15%;
			}
			#yes:focus{
				border: dashed $borderColor  75%;
			}
			#no{
				margin:1 0 0 0 ;
				border: dashed $ErrorColor 20%;
				background: $ErrorColor 15%;
			}
			#no:focus{
				border: dashed $ErrorColor 50%;
			}
		}



	}
	
}


#body{

    height: 100%;
    width: 100%;
    
    #top{

        height: 10%;
        width: 100%;
        margin: 0;
        padding: 0;

        #menu{
           
            height: 100%;
            width: 20%;
            padding: 0;
            #options{
                background: white 0%;
                
                padding: 1;
                content-align: center middle;
                ListItem{
                    height: 100%;
                    width: 100%;
                    align: center middle;
                    outline: double $borderColor;
                    
                    Label{
                        color: $textcolor;
                    }
                }

                #d{
                }
                #r{
                    
                    display:none;
                }
                #m{
                    display:none;
                }
                
            }
        }

        #montant{
            height: 100%;
            width: 80%;
            
            #chiffre{
                height: 100%;
                max-width: 33%;

            }
            #ID{
                height: 100%;
                width: 25%;
                display: none;
            }
      
            #raison{
                height:100%;
                max-width: 33%;
            }
            
			#date{
                height:100%;
                max-width:33%;
            }
        }
    }
        
    #middle{
        height: 70%;
        width: 100%;
        margin: 0;
        padding: 0;
        border-top: panel $borderColor 50%;

        #info{
            height: 100%;
            width: 20%;
            margin: 1;
        }
        #table{
            height: 100%;
            width: 80%;
            background: #171A17 100%;
            border: double $borderColor 60%;
            tint: #267326 5%;
        }
        #table:focus{
            border: double $borderColor 80%;
        }
        
        #left{
            border: $borderColor 62%;      
            #info{
                width: 100%;
                height: auto;
                border:  round $ErrorColor  62%;
                padding:1;
                margin: 1;
                align: left top;              
            }
        }

    }
}